# Copy to .env and fill in the providers you use. Never commit the real .env.
# animask/llm.py reads this file from the repository root; a variable already
# set in the process environment takes precedence.
#
# The provider is chosen from the model name (gpt-* -> OpenAI, claude-* ->
# Anthropic, gemini-*, deepseek-*, kimi-*, qwen*), or forced with a prefix
# such as "anthropic:claude-sonnet-5" or "compat:my-local-model".
# Only the providers you actually call need a key.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
DASHSCOPE_API_KEY=
OPENROUTER_API_KEY=

# Any OpenAI-compatible server (vLLM, Ollama, LM Studio, a gateway) for
# models that match no provider above, or for names prefixed "compat:".
COMPAT_BASE_URL=
COMPAT_API_KEY=

# Optional endpoint overrides (defaults are the providers' public APIs):
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional behaviour switches:
# LLM_MAX_WORKERS=10      concurrent calls per process (the batch runner lowers it)
# LLM_USAGE_LOG=0         accounting log path; default results/llm_usage.jsonl, 0 disables
# LLM_THINKING=default    keep DeepSeek / Moonshot reasoning on (the paper ran it off)
